# Stock Market Data Analyzer - Environment Variables Template
# Copy this file to .env and configure local values

# Application Environment (development, testing, production)
APP_ENV=development

# Data Directories
DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# Default Market Parameters
DEFAULT_TICKER=AAPL
DEFAULT_BENCHMARK=SPY
DEFAULT_PERIOD=1y
DEFAULT_INTERVAL=1d

# Optional External API Keys (future extensions)
# ALPHA_VANTAGE_API_KEY=your_key_here
